# OpenAI-compatible endpoint (e.g. an aggregator/router base URL)
VISION_BASE_URL=https://example.com/v1
VISION_API_KEY=sk-...
VISION_MODEL=ag/gemini-3.6-flash-medium

# Provider adapter: "openai-compatible" (default) or "openai" (Responses API, scaffold)
VISION_PROVIDER=openai-compatible

# Transport: "stdio" (default) or "http" (Streamable HTTP, POST /mcp)
VISION_TRANSPORT=stdio

# HTTP transport settings (used when VISION_TRANSPORT=http)
VISION_HTTP_HOST=127.0.0.1
VISION_HTTP_PORT=3000

# Output token budgets (CONCEPT.md §108)
VISION_DESCRIBE_OUTPUT_BUDGET=256
VISION_INSPECT_OUTPUT_BUDGET=384
VISION_OCR_OUTPUT_BUDGET=1024

# Provider request timeout (ms)
VISION_TIMEOUT_MS=60000

# Media limits (decoded image bytes)
VISION_MAX_IMAGE_BYTES=20971520

# Optional SSRF allowlist: comma-separated hostnames allowed to reach private networks
VISION_SSRF_ALLOW_HOSTS=

# Optional: base directory for resolving resource:// image references
VISION_RESOURCE_DIR=
